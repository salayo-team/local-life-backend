### 일반 사용자 로그인 testuser2
POST http://localhost:8080/auth/login
Content-Type: application/json

{
  "email": "testuser2@example.com",
  "password": "Test1234!"
}

> {%
  const json = response.body;
  const accessToken = json.data.accessToken;
  client.global.set("accessToken", accessToken);
%}

### ===== AI 적성 검사 전체 플로우 테스트 =====

### 1. 적성 테스트 시작
POST http://localhost:8080/ai/aptitude/test/start
Authorization: Bearer {{accessToken}}
Content-Type: application/json

> {%
  // 응답에서 첫 번째 질문 정보 저장
  console.log("테스트 시작 응답:", JSON.stringify(response.body));
  const data = response.body.data;
  if (data && data.aptitudeQuestionResponseDto) {
    client.global.set("currentStep", data.step);
    client.global.set("currentQuestion", data.aptitudeQuestionResponseDto.question);
    console.log("다음 단계:", data.step, "질문:", data.aptitudeQuestionResponseDto.question);
  } else {
    console.log("응답에 질문 정보가 없습니다");
  }
%}

### 2. 적성 테스트 답변 제출 - 동적 처리
# 이 요청을 5번 반복 실행하면 됩니다
POST http://localhost:8080/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "나는 자연과 관련된 활동을 정말 좋아해. 숲에서 시간을 보내고, 환경을 보호하는 일에 관심이 많아."
}

> {%
  // 응답 처리
  console.log("답변 제출 응답:", JSON.stringify(response.body));
  const data = response.body.data;

  if (data) {
    if (data.isComplete) {
      console.log("테스트 완료! 최종 적성:", data.finalAptitude);
      client.global.set("testComplete", true);
      client.global.set("finalAptitude", data.finalAptitude);
    } else if (data.aptitudeQuestionResponseDto) {
      // 다음 질문 정보 저장
      client.global.set("currentStep", data.step);
      client.global.set("currentQuestion", data.aptitudeQuestionResponseDto.question);
      console.log("다음 단계:", data.step, "질문:", data.aptitudeQuestionResponseDto.question);
    }
  }
%}

### 3. 재검사 가능 여부 확인
GET http://localhost:8080/ai/aptitude/can-retake
Authorization: Bearer {{accessToken}}
Content-Type: application/json

### ===== 적성 검사 이력 조회 =====

### 4. 완료된 적성 검사 이력 조회
GET http://localhost:8080/ai/aptitude/history
Authorization: Bearer {{accessToken}}

### 5. 특정 세션의 적성 검사 이력 조회
# sessionId를 실제 세션 ID로 변경해서 사용
GET http://localhost:8080/ai/aptitude/history/session?sessionId=APT-1-1234567890
Authorization: Bearer {{accessToken}}

> {%
  // 세션 ID 예시 출력
  console.log("세션 ID 예시: APT-{userId}-{timestamp}");
  console.log("실제 테스트 후 반환된 세션 ID를 사용할 것");
%}

### 6. 중단된 테스트 이어하기
GET http://localhost:8080/ai/aptitude/resume
Authorization: Bearer {{accessToken}}

> {%
  // 이어하기 결과 처리
  if (response.body.data) {
    const data = response.body.data;
    console.log("이어하기 성공!");
    console.log("세션 ID:", data.sessionId);
    console.log("다음 단계:", data.nextStep);
    console.log("완료된 단계:", data.completedSteps);
    console.log("메시지:", data.message);

    // 다음 질문 정보 저장
    if (data.nextQuestion) {
      client.global.set("currentStep", data.nextStep);
      client.global.set("currentQuestion", data.nextQuestion.question);
    }
  }
%}

### ===== 개별 단계별 테스트 (디버깅용) =====
# 테스트 시작을 먼저 실행한 후 아래 요청들을 순서대로 실행

### Step 1 - 고정값
POST http://localhost:8080/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "step": 1,
  "questionText": "너가 제일 좋아하는 활동은 뭐야?",
  "answer": "자연 속에서 산책하는 것을 좋아해"
}

### Step 2 - 고정값
POST http://localhost:8080/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "step": 2,
  "questionText": "주말에 뭐하면서 시간 보내는 걸 좋아해?",
  "answer": "산이나 바다로 나가서 힐링하기"
}

### Step 3 - 고정값
POST http://localhost:8080/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "step": 3,
  "questionText": "만약 지역에서 프로젝트를 한다면 어떤 걸 하고 싶어?",
  "answer": "생태 체험 프로그램이나 친환경 농업"
}

### Step 4 - 고정값
POST http://localhost:8080/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "step": 4,
  "questionText": "어떤 환경에서 일할 때 가장 행복해?",
  "answer": "자연과 가까운 조용한 환경"
}

### Step 5 - 고정값 (최종)
POST http://localhost:8080/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "step": 5,
  "questionText": "너의 강점은 뭐라고 생각해?",
  "answer": "자연과 교감하고 지속가능한 삶을 추구하는 것"
}

