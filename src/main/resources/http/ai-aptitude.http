### ========================================
### AI 적성 검사 API 테스트 (대화형 AI 버전)
### ========================================
### 환경: local, dev, prod
@host = http://localhost:8080
@contentType = application/json

### ===== 인증 =====

### 일반 사용자 로그인 (testuser2)
POST {{host}}/auth/login
Content-Type: {{contentType}}

{
  "email": "testuser1@example.com",
  "password": "test1234!"
}

> {%
  const json = response.body;
  const accessToken = json.data.accessToken;
  client.global.set("accessToken", accessToken);
  console.log("🎉 로그인 성공! Access Token 저장됨");
%}

### ========================================
### AI 대화형 적성 검사 - 실제 AI가 주도하는 테스트
### ========================================

### 1. 적성 검사 시작 - AI가 첫 질문 생성
POST {{host}}/ai/aptitude/test/start
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

> {%
  const data = response.body.data;
  if (data) {
    client.global.set("currentStep", data.step);
    if (data.aptitudeQuestionResponseDto) {
      // AI가 생성한 실제 질문 저장
      client.global.set("currentQuestion", data.aptitudeQuestionResponseDto.question);
      console.log("=== AI 적성 검사 시작 ===");
      console.log("현재 단계:", data.step, "/", data.totalSteps);
      console.log("\n🔮 AI 질문:", data.aptitudeQuestionResponseDto.question);
      console.log("\n💭 이 질문에 자유롭게 답변하세요!");
    }
  }
%}

### ========================================
### 다양한 답변 시나리오 - AI가 동적으로 처리
### ========================================

### 2-1. 자연친화적 답변 시나리오
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "저는 숲에서 새소리 듣는 것을 좋아해요. 자연과 함께 있을 때 마음이 편안해집니다."
}

> {%
  const data = response.body.data;
  if (data) {
    if (data.isComplete) {
      console.log("\n🎉 테스트 완료!");
      console.log("AI가 분석한 당신의 적성:", data.finalAptitude);
      client.global.set("finalAptitude", data.finalAptitude);
    } else {
      client.global.set("currentStep", data.step);
      if (data.aptitudeQuestionResponseDto) {
        client.global.set("currentQuestion", data.aptitudeQuestionResponseDto.question);
        console.log("\n--- 다음 단계 ---");
        console.log("\n➡️ 진행 상황:", data.step, "/", data.totalSteps);
        console.log("\n🔮 AI 질문:", data.aptitudeQuestionResponseDto.question);
      }
    }
  }
%}

### 2-2. 예술창작적 답변 시나리오
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "그림 그리고 뭔가 만드는 걸 좋아해요. 손으로 직접 창작하는 활동이 제일 즐거워요."
}

### 2-3. 기술중심 답변 시나리오
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "코딩하고 앱 개발하는 게 재밌어요. 기술로 문제를 해결하는 것에 관심이 많아요."
}

### 2-4. 커뮤니티 중심 답변 시나리오
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "사람들과 만나서 이야기하는 게 좋아요. 함께 모여서 뭔가 하는 활동이 즐거워요."
}

### 2-5. 역사문화 관심 답변 시나리오
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "옛날 이야기나 전통 문화에 관심이 많아요. 박물관이나 고택 방문하는 걸 좋아해요."
}

### ========================================
### 예외 상황 처리 - AI가 대화 유도
### ========================================

### 3-1. 엉뚱한 답변 - AI가 다시 질문 유도
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "배고파요. 점심 뭐 먹을까요?"
}

> {%
  console.log("💬 예외 답변 처리 - AI가 어떻게 대화를 이어가는지 확인");
  const data = response.body.data;
  if (data && data.aptitudeQuestionResponseDto) {
    console.log("🔮 AI 반응:", data.aptitudeQuestionResponseDto.question);
    console.log("AI가 자연스럽게 다시 적성 검사로 유도하는지 확인!");
  }
%}

### 3-2. 너무 짧은 답변
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "몰라요"
}

### 3-3. 질문과 무관한 답변
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "오늘 날씨가 좋네요. 비 올 것 같기도 하고요."
}

### ========================================
### 복합적 답변 - AI의 판단력 테스트
### ========================================

### 4-1. 여러 적성이 섞인 답변
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "자연 속에서 사람들과 함께 예술 활동하는 것을 좋아해요. 특히 디지털 아트로 자연을 표현하는 것에 관심이 있어요."
}

> {%
  console.log("🔎 복합 답변 분석 - AI가 어떤 적성을 우선시하는지 확인");
%}

### 4-2. 모호한 답변
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "그냥 이것저것 다 좋아해요. 특별히 좋아하는 건 없는 것 같아요."
}

### ========================================
### 대화 흐름 테스트 - 5단계 완성
### ========================================

### 5. 전체 대화 플로우 (동적 질문-답변)
# Step 1-5를 순차적으로 실행하되, 매번 AI의 질문에 따라 답변 조정

### Step 1 - AI 질문에 대한 자유 답변
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "여기에 AI 질문을 보고 자유롭게 답변을 작성하세요"
}

### Step 2 - 이어지는 대화
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "AI가 이전 답변을 고려해서 물어본 질문에 답변"
}

### Step 3 - 대화 중반
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "점점 구체화되는 답변"
}

### Step 4 - 심화 대화
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "더 깊이 있는 개인적 선호 표현"
}

### Step 5 - 마지막 대화 (결과 도출)
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "최종적인 나의 관심사와 성향 표현"
}

> {%
  const data = response.body.data;
  if (data && data.isComplete) {
    console.log("\n========= AI 적성 분석 완료 =========");
    console.log("✨ 최종 적성:", data.finalAptitude);
    console.log("=====================================");

    // 적성별 설명
    const descriptions = {
      "NATURE": "🌿 자연친화 - 자연과 함께하는 삶을 추구",
      "HISTORY_CULTURE": "🏛️ 역사문화 - 지역의 역사와 문화 탐구",
      "ART_CREATION": "🎨 예술창작 - 창의적 활동과 예술 추구",
      "COMMUNITY": "👥 커뮤니티 - 사람들과의 연결과 소통",
      "TECH": "💻 디지털기술 - 기술로 문제 해결"
    };

    console.log(descriptions[data.finalAptitude] || "\n❓알 수 없는 적성");
  }
%}

### ========================================
### 테스트 시나리오 검증
### ========================================

### 시나리오 A: AI 대화 연속성 테스트
# 1. 테스트 시작
# 2. 일관된 성향의 답변 5개
# 3. AI가 일관된 적성 판단하는지 확인

### 시나리오 B: AI 예외처리 능력 테스트
# 1. 테스트 시작
# 2. 엉뚱한 답변 2개
# 3. 정상 답변 3개
# 4. AI가 적절히 대화 유도하고 최종 적성 도출하는지 확인

### 시나리오 C: AI 판단력 테스트
# 1. 테스트 시작
# 2. 서로 다른 적성 답변 섞어서 5개
# 3. AI가 가장 우세한 적성 찾아내는지 확인

### ========================================
### 기타 기능 테스트
### ========================================

### 재검사 가능 여부 확인
GET {{host}}/ai/aptitude/can-retake
Authorization: Bearer {{accessToken}}

### 테스트 이력 조회
GET {{host}}/ai/aptitude/history
Authorization: Bearer {{accessToken}}

### 중단된 테스트 이어하기
GET {{host}}/ai/aptitude/resume
Authorization: Bearer {{accessToken}}

### ===== 수동 적성 선택 (AI 추천 건너뛰기) =====

### 적성 수동 선택 (NATURE)
POST {{host}}/ai/aptitude/select?aptitudeType=NATURE
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

### 적성 수동 선택 (ART_CREATION)
POST {{host}}/ai/aptitude/select?aptitudeType=ART_CREATION
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

### 적성 수동 선택 (COMMUNITY)
POST {{host}}/ai/aptitude/select?aptitudeType=COMMUNITY
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

### 적성 수동 선택 (TECH)
POST {{host}}/ai/aptitude/select?aptitudeType=TECH
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

### 적성 수동 선택 (HISTORY_CULTURE)
POST {{host}}/ai/aptitude/select?aptitudeType=HISTORY_CULTURE
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

### ========================================
### 주의사항 및 테스트 가이드
### ========================================

# ⚠️ 중요: AI와의 실제 대화형 테스트
# 1. 각 단계마다 AI가 생성한 질문을 확인하고 답변
# 2. 고정된 질문-답변이 아닌 동적 대화
# 3. temperature=0.7로 창의적 질문 생성
# 4. 예외 답변도 자연스럽게 처리
# 5. 5단계 대화 후 적성 도출

# 📝 테스트 팁:
# - currentQuestion 변수에 AI 질문이 자동 저장됨
# - 콘솔에서 AI 질문 확인 후 답변 작성
# - 다양한 답변 시도해보기
# - AI의 대화 유도 능력 확인
