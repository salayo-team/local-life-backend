### 6. Step 5/5 - 마지막 답변 (테스트 완료)
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{nextStep}},
  "questionText": "{{questionText}}",
  "answer": "최신 기술 트렌드를 따라가고 새로운 프로그래밍 언어를 익히는 것이 제 취미입니다."
}

> {%
  const data = response.body.data;
  if (data.isComplete) {
    console.log("\n🎉 체이닝 테스트 완료!");
    console.log("최종 적성:", data.finalAptitude);
    client.global.set("finalAptitude", data.finalAptitude);
  } else {
    console.log("✅ Step 5 완료");
  }
%}

