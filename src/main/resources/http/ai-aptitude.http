### ========================================
### AI 적성 검사 API 테스트 (대화형 AI 버전)
### ========================================
### 환경: local, dev, prod
@host = http://localhost:8080
@contentType = application/json

### ===== 인증 =====

### 일반 사용자 로그인 (testuser2)
POST {{host}}/auth/login
Content-Type: {{contentType}}

{
  "email": "testuser1@example.com",
  "password": "test1234!"
}

> {%
  const json = response.body;
  const accessToken = json.data.accessToken;
  client.global.set("accessToken", accessToken);
  console.log("🎉 로그인 성공! Access Token 저장됨");
%}

### ========================================
### AI 대화형 적성 검사 - 실제 AI가 주도하는 테스트
### ========================================

### 1. 적성 검사 시작 - AI가 첫 질문 생성
# @name startTest
POST {{host}}/ai/aptitude/test/start
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

> {%
  const data = response.body.data;
  if (data) {
    // 다음 단계와 질문 내용을 변수로 저장 (이어하기 테스트를 위해)
    client.global.set("nextStep", data.step);
    client.global.set("currentStep", data.step);
    client.global.set("totalSteps", data.totalSteps);
    
    if (data.aptitudeQuestionResponseDto) {
      // AI가 생성한 실제 질문 저장
      client.global.set("questionText", data.aptitudeQuestionResponseDto.question);
      client.global.set("currentQuestion", data.aptitudeQuestionResponseDto.question);
      console.log("=== AI 적성 검사 시작 ===");
      console.log("현재 단계:", data.step, "/", data.totalSteps);
      console.log("\n🔮 AI 질문:", data.aptitudeQuestionResponseDto.question);
      console.log("\n💭 이 질문에 자유롭게 답변하세요!");
    }
  }
%}

### ========================================
### [시나리오 1] 테스트 이어하기 (Resume) - 가장 중요
### ========================================

### 2. 첫 번째 답변만 제출 (테스트 중단 상황 가정)
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{nextStep}},
  "questionText": "{{questionText}}",
  "answer": "저는 사람들과 협력하며 함께 문제를 해결할 때 가장 큰 성취감을 느낍니다."
}

> {%
  const data = response.body.data;
  if (data) {
    // 다음 질문 정보 업데이트
    client.global.set("nextStep", data.step);
    client.global.set("currentStep", data.step);
    if (data.aptitudeQuestionResponseDto) {
      client.global.set("questionText", data.aptitudeQuestionResponseDto.question);
      client.global.set("currentQuestion", data.aptitudeQuestionResponseDto.question);
    }
    console.log("✅ 첫 번째 답변 제출 완료");
    console.log("📍 진행 상황:", data.step, "/", data.totalSteps);
    console.log("⏸️ 여기서 테스트를 중단한다고 가정...");
  }
%}

### 3. 테스트 이어하기 요청
# 이 요청은 DB에 저장된 부분 저장 정보를 기반으로 Redis 상태를 복구하고
# 다음 질문을 반환해야 합니다.
POST {{host}}/ai/aptitude/test/resume
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

> {%
  const data = response.body.data;
  if (data) {
    client.global.set("nextStep", data.step);
    client.global.set("currentStep", data.step);
    if (data.aptitudeQuestionResponseDto) {
      client.global.set("questionText", data.aptitudeQuestionResponseDto.question);
      client.global.set("currentQuestion", data.aptitudeQuestionResponseDto.question);
    }
    console.log("🔄 테스트 이어하기 성공!");
    console.log("📍 복구된 단계:", data.step, "/", data.totalSteps);
    console.log("🔮 다음 질문:", data.aptitudeQuestionResponseDto?.question);
  }
%}

### 4. 이어진 테스트에서 두 번째 답변 제출
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{nextStep}},
  "questionText": "{{questionText}}",
  "answer": "특히 브레인스토밍 세션에서 다양한 아이디어가 나올 때 흥미롭습니다."
}

> {%
  const data = response.body.data;
  if (data) {
    client.global.set("nextStep", data.step);
    client.global.set("currentStep", data.step);
    if (data.aptitudeQuestionResponseDto) {
      client.global.set("questionText", data.aptitudeQuestionResponseDto.question);
      client.global.set("currentQuestion", data.aptitudeQuestionResponseDto.question);
    }
    console.log("✅ 이어진 테스트에서 답변 제출 성공");
  }
%}

### ========================================
### [시나리오 2] 테스트 시작부터 끝까지 (체이닝 강화)
### ========================================

### 1. 새 테스트 시작 (체이닝용)
# @name chainedStart
POST {{host}}/ai/aptitude/test/start
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

> {%
  // 응답에서 다음 단계와 질문 내용을 변수로 저장
  const data = response.body.data;
  client.global.set("nextStep", data.step);
  client.global.set("questionText", data.aptitudeQuestionResponseDto.question);
  console.log("🚀 체이닝 테스트 시작");
  console.log("Step:", data.step, "Question:", data.aptitudeQuestionResponseDto.question);
%}

### 2. Step 1/5 - 첫 번째 답변
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{nextStep}},
  "questionText": "{{questionText}}",
  "answer": "저는 혼자 깊이 파고드는 연구 활동을 선호합니다. 특히 데이터를 분석하고 패턴을 찾는 것을 즐깁니다."
}

> {%
  // 응답에서 다음 단계와 질문 내용을 다시 업데이트
  const data = response.body.data;
  if (!data.isComplete) {
    client.global.set("nextStep", data.step);
    client.global.set("questionText", data.aptitudeQuestionResponseDto.question);
    console.log("✅ Step 1 완료");
    console.log("Next Step:", data.step, "Next Question:", data.aptitudeQuestionResponseDto.question);
  }
%}

