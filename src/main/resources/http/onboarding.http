### ========================================
### 온보딩 플로우 API 테스트
### ========================================
### 환경: local
@host = http://localhost:8080
@contentType = application/json

### ========================================
### Step 0: 인증
### ========================================

### 0-1. 일반 사용자 로그인
POST {{host}}/auth/login
Content-Type: {{contentType}}

{
  "email": "testuser1@example.com",
  "password": "test1234!"
}

> {%
  const json = response.body;
  const accessToken = json.data.accessToken;
  client.global.set("accessToken", accessToken);
  console.log("로그인 성공! Access Token 저장됨");
%}

### ========================================
### Step 1: 온보딩 시작 및 상태 확인
### ========================================

### 1-1. 온보딩 시작
POST {{host}}/onboarding/start
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

> {%
  const data = response.body.data;
  if (data) {
    client.global.set("sessionId", data.sessionId);
    console.log("\n=== 온보딩 시작 ===");
    console.log("세션 ID:", data.sessionId);
    console.log("현재 단계:", data.currentStep);
    console.log("다음 단계:", data.nextStep);
    console.log("메시지:", data.message);
    if (data.nextAction) {
      console.log("\n다음 액션:");
      console.log("- Type:", data.nextAction.type);
      console.log("- Endpoint:", data.nextAction.endpoint);
      console.log("- Method:", data.nextAction.method);
    }
  }
%}

### 1-2. 온보딩 진행 상태 조회
GET {{host}}/onboarding/progress
Authorization: Bearer {{accessToken}}

> {%
  const data = response.body.data;
  if (data) {
    console.log("\n=== 현재 온보딩 상태 ===");
    console.log("세션 ID:", data.sessionId);
    console.log("현재 단계:", data.currentStep);
    console.log("완료 여부:", data.isCompleted);
    console.log("선택한 지역 특징:", data.regionType);
    console.log("적성 인지 여부:", data.knowsAptitude);
  }
%}

### 1-3. 온보딩 상태 조회 (이어하기용)
GET {{host}}/onboarding/status
Authorization: Bearer {{accessToken}}

### ========================================
### Step 2: 선호 지역 선택
### ========================================

### 2-1. 선호 지역 특징 선택 - URBAN (도시형)
POST {{host}}/onboarding/region
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "regionType": "URBAN"
}

> {%
  const data = response.body.data;
  if (data) {
    console.log("\n=== 선호 지역 특징 선택 완료 ===");
    console.log("선택한 지역 특징:", data.regionType);
    console.log("현재 단계:", data.currentStep);
    console.log("다음 단계:", data.nextStep);
    console.log("메시지:", data.message);
    if (data.nextAction) {
      console.log("\n다음 액션:");
      console.log("- Type:", data.nextAction.type);
      console.log("- Endpoint:", data.nextAction.endpoint);
    }
  }
%}

### 2-2. 선호 지역 특징 선택 - BALANCED (균형형)
POST {{host}}/onboarding/region
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "regionType": "BALANCED"
}

### 2-3. 선호 지역 특징 선택 - NATURE (자연형)
POST {{host}}/onboarding/region
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "regionType": "NATURE"
}

### ========================================
### Step 3: 적성 인지 여부 확인 (분기점)
### ========================================

### 3-1. 적성을 알고 있는 경우 → 수동 선택으로 이동
POST {{host}}/onboarding/aptitude-check
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "knowsAptitude": true
}

> {%
  const data = response.body.data;
  if (data) {
    console.log("\n=== 적성 인지 확인 (알고있음) ===");
    console.log("적성 인지:", data.knowsAptitude);
    console.log("현재 단계:", data.currentStep);
    console.log("다음 단계:", data.nextStep);
    console.log("메시지:", data.message);
    if (data.nextAction) {
      console.log("\n✍️ 다음 액션: 수동 적성 선택");
      console.log("- Endpoint:", data.nextAction.endpoint);
      console.log("- Description:", data.nextAction.description);
    }
  }
%}

### 3-2. 적성을 모르는 경우 → AI 검사로 이동
POST {{host}}/onboarding/aptitude-check
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "knowsAptitude": false
}

> {%
  const data = response.body.data;
  if (data) {
    console.log("\n=== 적성 인지 확인 (모름) ===");
    console.log("적성 인지:", data.knowsAptitude);
    console.log("현재 단계:", data.currentStep);
    console.log("다음 단계:", data.nextStep);
    console.log("메시지:", data.message);
    if (data.nextAction) {
      console.log("\n🔮 다음 액션: AI 적성 검사");
      console.log("- Endpoint:", data.nextAction.endpoint);
      console.log("- Description:", data.nextAction.description);
    }
  }
%}

### ========================================
### Step 4-A: 수동 적성 선택 (knowsAptitude: true인 경우)
### ========================================

### 4-A-1. 수동으로 NATURE 적성 선택
POST {{host}}/ai/aptitude/select
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "aptitudeType": "NATURE"
}

> {%
  console.log("\n✅ 수동 적성 선택 완료: NATURE");
  console.log("온보딩 플로우 계속...");
%}

### 4-A-2. 수동으로 HISTORY_CULTURE 적성 선택
POST {{host}}/ai/aptitude/select
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "aptitudeType": "HISTORY_CULTURE"
}

> {%
  console.log("\n✅ 수동 적성 선택 완료: HISTORY_CULTURE");
  console.log("온보딩 플로우 계속...");
%}

### 4-A-3. 수동으로 ART_CREATION 적성 선택
POST {{host}}/ai/aptitude/select
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "aptitudeType": "ART_CREATION"
}

> {%
  console.log("\n✅ 수동 적성 선택 완료: ART_CREATION");
  console.log("온보딩 플로우 계속...");
%}

### 4-A-4. 수동으로 COMMUNITY 적성 선택
POST {{host}}/ai/aptitude/select
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "aptitudeType": "COMMUNITY"
}

> {%
  console.log("\n✅ 수동 적성 선택 완료: COMMUNITY");
  console.log("온보딩 플로우 계속...");
%}

### 4-A-5. 수동으로 TECH 적성 선택
POST {{host}}/ai/aptitude/select
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "aptitudeType": "TECH"
}

> {%
  console.log("\n✅ 수동 적성 선택 완료: TECH");
  console.log("온보딩 플로우 계속...");
%}

### ========================================
### Step 4-B: AI 적성 검사 (knowsAptitude: false인 경우)
### ========================================

### 4-B-1. AI 적성 검사 시작
POST {{host}}/ai/aptitude/test/start
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

> {%
  const data = response.body.data;
  if (data) {
    client.global.set("currentStep", data.step);
    if (data.aptitudeQuestionResponseDto) {
      client.global.set("currentQuestion", data.aptitudeQuestionResponseDto.question);
      console.log("\n🔮 AI 적성 검사 시작");
      console.log("질문:", data.aptitudeQuestionResponseDto.question);
    }
  }
%}

### 4-B-2. AI 검사 답변 제출 (5회 반복 필요)
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "자연 속에서 산책하는 것을 좋아해요"
}

> {%
  const data = response.body.data;
  if (data) {
    if (data.isComplete) {
      console.log("\n✅ AI 적성 검사 완료!");
      console.log("최종 적성:", data.finalAptitude);
    } else {
      client.global.set("currentStep", data.step);
      if (data.aptitudeQuestionResponseDto) {
        client.global.set("currentQuestion", data.aptitudeQuestionResponseDto.question);
        console.log("\n다음 질문:", data.aptitudeQuestionResponseDto.question);
      }
    }
  }
%}

### ========================================
### Step 5: 온보딩 완료
### ========================================

### 5-1. 온보딩 완료 처리
POST {{host}}/onboarding/complete
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

> {%
  const data = response.body.data;
  if (data) {
    console.log("\n🎉 온보딩 완료!");
    console.log("세션 ID:", data.sessionId);
    console.log("선택한 지역 특징:", data.regionType);
    console.log("완료 상태:", data.isCompleted);
    if (data.nextAction) {
      console.log("\n다음 이동:");
      console.log("- Endpoint:", data.nextAction.endpoint);
      console.log("- Description:", data.nextAction.description);
    }
  }
%}

### ========================================
### Step 6: 선호 지역 관리 (마이페이지용)
### ========================================

### 6-1. 내 선호 지역 목록 조회
GET {{host}}/preferred-regions/view
Authorization: Bearer {{accessToken}}

> {%
  client.test("선호 지역 조회 성공", function() {
    client.assert(response.status === 200, "Status code is 200");
    const data = response.body.data;
    console.log("선호 지역 목록:", data);
    console.log("지역 개수:", data.length);
  });
%}

### 6-2. 선호 지역 변경 - URBAN으로 변경
PUT {{host}}/preferred-regions/reselect
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "regionType": "URBAN"
}

> {%
  client.test("선호 지역 변경 성공", function() {
    client.assert(response.status === 200, "Status code is 200");
    const regions = response.body.data;
    console.log("변경된 지역 목록:", regions);
    console.log("URBAN 지역 개수:", regions.length);
    client.assert(regions.length === 7, "도시형은 7개 지역");
    client.assert(regions.includes("서울"), "서울 포함 확인");
  });
%}

### 6-3. 선호 지역 변경 - BALANCED로 변경
PUT {{host}}/user/preferred-regions
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "regionType": "BALANCED"
}

> {%
  client.test("선호 지역 변경 성공", function() {
    client.assert(response.status === 200, "Status code is 200");
    const regions = response.body.data;
    console.log("변경된 지역 목록:", regions);
    console.log("BALANCED 지역 개수:", regions.length);
    client.assert(regions.length === 5, "균형형은 5개 지역");
    client.assert(regions.includes("경기"), "경기 포함 확인");
  });
%}

### 6-4. 선호 지역 변경 - NATURE로 변경
PUT {{host}}/user/preferred-regions
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "regionType": "NATURE"
}

> {%
  client.test("선호 지역 변경 성공", function() {
    client.assert(response.status === 200, "Status code is 200");
    const regions = response.body.data;
    console.log("변경된 지역 목록:", regions);
    console.log("NATURE 지역 개수:", regions.length);
    client.assert(regions.length === 4, "자연형은 4개 지역");
    client.assert(regions.includes("강원"), "강원 포함 확인");
    client.assert(regions.includes("제주"), "제주 포함 확인");
  });
%}

### ========================================
### Step 7: 에러 케이스 테스트
### ========================================

### 7-1. 잘못된 RegionType 테스트
POST {{host}}/onboarding/region
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "regionType": "INVALID_TYPE"
}

### 7-2. 필수 값 누락 테스트
POST {{host}}/onboarding/region
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
}

### 7-3. 인증 없이 요청
GET {{host}}/user/preferred-regions

### 7-4. 온보딩 미완료 상태에서 지역 조회
# 온보딩 완료 전에 호출하면 ONBOARDING_NOT_COMPLETED 에러 발생
GET {{host}}/user/preferred-regions
Authorization: Bearer {{accessToken}}

### 7-5. 잘못된 단계에서 지역 선택 시도
POST {{host}}/onboarding/region
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "regionType": "URBAN"
}

### 7-6. 잘못된 단계에서 적성 확인 시도
POST {{host}}/onboarding/aptitude-check
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "knowsAptitude": true
}

### 7-7. 이미 완료된 온보딩 재시작 시도
POST {{host}}/onboarding/start
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

### ========================================
### 시나리오별 전체 플로우 가이드
### ========================================

### 시나리오 A: 적성을 아는 사용자
# 0-1. 로그인
# 1-1. 온보딩 시작
# 2-1. 지역 특징 선택 (URBAN)
# 3-1. 적성 인지 여부 (true - 알고있음)
# 4-A-1. 수동 적성 선택 (NATURE)
# 5-1. 온보딩 완료

### 시나리오 B: 적성을 모르는 사용자
# 0-1. 로그인
# 1-1. 온보딩 시작
# 2-2. 지역 특징 선택 (BALANCED)
# 3-2. 적성 인지 여부 (false - 모름)
# 4-B-1. AI 적성 검사 시작
# 4-B-2. AI 검사 답변 제출 (5회 반복)
# 5-1. 온보딩 완료

### ========================================
### 온보딩 플로우 다이어그램
### ========================================
# 
#     [시작]
#       ↓
#   [회원 정보]
#       ↓
#   [지역 선택]
#       ↓
#  [적성 인지?]
#    ↙    ↘
#  [예]    [아니오]
#   ↓        ↓
# [수동]   [AI검사]
#   ↓        ↓
#   ↘      ↙
#    [완료]
#
### ========================================
