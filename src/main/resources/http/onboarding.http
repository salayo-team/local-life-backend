### ========================================
### Step 4-B: AI 적성 검사 (knowsAptitude: false인 경우)
### ========================================

### 4-B-1. AI 적성 검사 시작
POST {{host}}/ai/aptitude/test/start
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

> {%
  const data = response.body.data;
  if (data) {
    client.global.set("currentStep", data.step);
    if (data.aptitudeQuestionResponseDto) {
      client.global.set("currentQuestion", data.aptitudeQuestionResponseDto.question);
      console.log("\n🔮 AI 적성 검사 시작");
      console.log("질문:", data.aptitudeQuestionResponseDto.question);
    }
  }
%}

### 4-B-2. AI 검사 답변 제출 (5회 반복 필요)
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "자연 속에서 산책하는 것을 좋아해요"
}

> {%
  const data = response.body.data;
  if (data) {
    if (data.isComplete) {
      console.log("\n✅ AI 적성 검사 완료!");
      console.log("최종 적성:", data.finalAptitude);
    } else {
      client.global.set("currentStep", data.step);
      if (data.aptitudeQuestionResponseDto) {
        client.global.set("currentQuestion", data.aptitudeQuestionResponseDto.question);
        console.log("\n다음 질문:", data.aptitudeQuestionResponseDto.question);
      }
    }
  }
%}

### ========================================
### Step 5: 온보딩 완료
### ========================================

### 5-1. 온보딩 완료 처리
POST {{host}}/onboarding/complete
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

> {%
  const data = response.body.data;
  if (data) {
    console.log("\n🎉 온보딩 완료!");
    console.log("세션 ID:", data.sessionId);
    console.log("선택한 지역 특징:", data.regionType);
    console.log("완료 상태:", data.isCompleted);
    if (data.nextAction) {
      console.log("\n다음 이동:");
      console.log("- Endpoint:", data.nextAction.endpoint);
      console.log("- Description:", data.nextAction.description);
    }
  }
%}

### ========================================
### Step 6: 선호 지역 관리 (마이페이지용)
### ========================================

### 6-1. 내 선호 지역 목록 조회
GET {{host}}/preferred-regions/view
Authorization: Bearer {{accessToken}}

> {%
  client.test("선호 지역 조회 성공", function() {
    client.assert(response.status === 200, "Status code is 200");
    const data = response.body.data;
    console.log("선호 지역 목록:", data);
    console.log("지역 개수:", data.length);
  });
%}

### 6-2. 선호 지역 변경 - URBAN으로 변경
PUT {{host}}/preferred-regions/reselect
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "regionType": "URBAN"
}

> {%
  client.test("선호 지역 변경 성공", function() {
    client.assert(response.status === 200, "Status code is 200");
    const regions = response.body.data;
    console.log("변경된 지역 목록:", regions);
    console.log("URBAN 지역 개수:", regions.length);
    client.assert(regions.length === 7, "도시형은 7개 지역");
    client.assert(regions.includes("서울"), "서울 포함 확인");
  });
%}

### 6-3. 선호 지역 변경 - BALANCED로 변경
PUT {{host}}/preferred-regions/reselect
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "regionType": "BALANCED"
}

> {%
  client.test("선호 지역 변경 성공", function() {
    client.assert(response.status === 200, "Status code is 200");
    const regions = response.body.data;
    console.log("변경된 지역 목록:", regions);
    console.log("BALANCED 지역 개수:", regions.length);
    client.assert(regions.length === 5, "균형형은 5개 지역");
    client.assert(regions.includes("경기"), "경기 포함 확인");
  });
%}

### 6-4. 선호 지역 변경 - NATURE로 변경
PUT {{host}}/preferred-regions/reselect
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "regionType": "NATURE"
}

> {%
  client.test("선호 지역 변경 성공", function() {
    client.assert(response.status === 200, "Status code is 200");
    const regions = response.body.data;
    console.log("변경된 지역 목록:", regions);
    console.log("NATURE 지역 개수:", regions.length);
    client.assert(regions.length === 4, "자연형은 4개 지역");
    client.assert(regions.includes("강원"), "강원 포함 확인");
    client.assert(regions.includes("제주"), "제주 포함 확인");
  });
%}

### ========================================
### Step 7: 체험 프로그램 추천 (온보딩 완료 후)
### ========================================
### 온보딩 완료 후 사용자 맞춤 프로그램 6개를 랜덤 추천합니다.
### 사용자의 적성과 선호 지역을 기반으로 프로그램을 추천합니다.
### ========================================

### 7-1. 추천 프로그램 조회 (온보딩 완료 후)
GET {{host}}/recommended-programs/random
Authorization: Bearer {{accessToken}}

> {%
  const data = response.body.data;
  if (data && Array.isArray(data)) {
    console.log("\n🎯 === 맞춤 체험 프로그램 추천 결과 ===");
    console.log("추천 프로그램 개수:", data.length);
    
    data.forEach((program, index) => {
      console.log(`\n[프로그램 ${index + 1}]`);
      console.log("- ID:", program.programId);
      console.log("- 제목:", program.title);
      console.log("- 업체명:", program.businessName);
      console.log("- 위치:", program.location);
      console.log("- 가격:", program.price + "원");
      console.log("- 할인가:", program.finalPrice + "원");
      console.log("- 할인율:", program.percent + "%");
      console.log("- 적성:", program.aptitudeCategory);
      console.log("- 지역:", program.regionCategory);
      console.log("- 지역특화:", program.isLocalSpecialized ? "O" : "X");
      console.log("- 시작일:", program.startDate);
      console.log("- 종료일:", program.endDate);
    });
    
    // 적성별 분포 확인
    const aptitudes = {};
    data.forEach(p => {
      aptitudes[p.aptitudeCategory] = (aptitudes[p.aptitudeCategory] || 0) + 1;
    });
    console.log("\n📊 적성별 분포:", aptitudes);
    
    // 지역별 분포 확인
    const regions = {};
    data.forEach(p => {
      regions[p.regionCategory] = (regions[p.regionCategory] || 0) + 1;
    });
    console.log("📍 지역별 분포:", regions);
    
    client.assert(data.length === 6, "추천 프로그램은 6개여야 함");
    client.assert(data.every(p => p.programId), "모든 프로그램에 ID가 있어야 함");
    client.assert(data.every(p => p.aptitudeCategory), "모든 프로그램에 적성 카테고리가 있어야 함");
    client.assert(data.every(p => p.regionCategory), "모든 프로그램에 지역 카테고리가 있어야 함");
  } else {
    console.log("⚠️ 추천 프로그램이 없습니다.");
    console.log("온보딩이 완료되었는지 확인하세요.");
  }
%}

### 7-2. 추천 프로그램 재조회 (랜덤성 확인)
### 같은 요청을 다시 보내도 랜덤하게 다른 6개가 추천되는지 확인
GET {{host}}/recommended-programs/random
Authorization: Bearer {{accessToken}}

> {%
  const data = response.body.data;
  if (data && Array.isArray(data)) {
    console.log("\n🔄 === 추천 프로그램 재조회 (랜덤성 테스트) ===");
    console.log("추천 프로그램 개수:", data.length);
    
    const programIds = data.map(p => p.programId);
    console.log("프로그램 ID 목록:", programIds);
    console.log("\n💡 이전 요청과 다른 프로그램이 추천되었는지 확인하세요!");
  }
%}

