### ========================================
### 온보딩 플로우 API 테스트
### ========================================
### 환경: local
@host = http://localhost:8080
@contentType = application/json

### ===== Step 0: 인증 =====

### 일반 사용자 로그인 (testuser2)
POST {{host}}/auth/login
Content-Type: {{contentType}}

{
  "email": "testuser1@example.com",
  "password": "test1234!"
}

> {%
  const json = response.body;
  const accessToken = json.data.accessToken;
  client.global.set("accessToken", accessToken);
  console.log("로그인 성공! Access Token 저장됨");
%}

### ========================================
### 온보딩 플로우
### ========================================

### 1. 온보딩 시작
POST {{host}}/onboarding/start
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

> {%
  const data = response.body.data;
  if (data) {
    client.global.set("sessionId", data.sessionId);
    console.log("\n=== 온보딩 시작 ===");
    console.log("세션 ID:", data.sessionId);
    console.log("현재 단계:", data.currentStep);
    console.log("다음 단계:", data.nextStep);
    console.log("메시지:", data.message);
    if (data.nextAction) {
      console.log("\n다음 액션:");
      console.log("- Type:", data.nextAction.type);
      console.log("- Endpoint:", data.nextAction.endpoint);
      console.log("- Method:", data.nextAction.method);
    }
  }
%}

### 2. 선호 지역 선택
POST {{host}}/onboarding/region
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "regionType": "URBAN"
}

> {%
  const data = response.body.data;
  if (data) {
    console.log("\n=== 선호 지역 특징 선택 완료 ===");
    console.log("선택한 지역 특징:", data.regionType);
    console.log("현재 단계:", data.currentStep);
    console.log("다음 단계:", data.nextStep);
    console.log("메시지:", data.message);
    if (data.nextAction) {
      console.log("\n다음 액션:");
      console.log("- Type:", data.nextAction.type);
      console.log("- Endpoint:", data.nextAction.endpoint);
    }
  }
%}

### ========================================
### 3. 적성 인지 여부 확인 (분기점)
### ========================================

### 3-1. 적성을 알고 있는 경우 → 수동 선택으로 이동
POST {{host}}/onboarding/aptitude-check
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "knowsAptitude": true
}

> {%
  const data = response.body.data;
  if (data) {
    console.log("\n=== 적성 인지 확인 (알고있음) ===");
    console.log("적성 인지:", data.knowsAptitude);
    console.log("현재 단계:", data.currentStep);
    console.log("다음 단계:", data.nextStep);
    console.log("메시지:", data.message);
    if (data.nextAction) {
      console.log("\n✍️ 다음 액션: 수동 적성 선택");
      console.log("- Endpoint:", data.nextAction.endpoint);
      console.log("- Description:", data.nextAction.description);
    }
  }
%}

### 3-2. 적성을 모르는 경우 → AI 검사로 이동
POST {{host}}/onboarding/aptitude-check
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "knowsAptitude": false
}

> {%
  const data = response.body.data;
  if (data) {
    console.log("\n=== 적성 인지 확인 (모름) ===");
    console.log("적성 인지:", data.knowsAptitude);
    console.log("현재 단계:", data.currentStep);
    console.log("다음 단계:", data.nextStep);
    console.log("메시지:", data.message);
    if (data.nextAction) {
      console.log("\n🔮 다음 액션: AI 적성 검사");
      console.log("- Endpoint:", data.nextAction.endpoint);
      console.log("- Description:", data.nextAction.description);
    }
  }
%}

### ========================================
### 4-A. 수동 적성 선택 (knowsAptitude: true)
### ========================================

### 수동으로 NATURE 적성 선택
POST {{host}}/ai/aptitude/select
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "aptitudeType": "NATURE"
}

> {%
  console.log("\n✅ 수동 적성 선택 완료: NATURE");
  console.log("온보딩 플로우 계속...");
%}


