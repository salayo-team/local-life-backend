### ========================================
### 4-B. AI 적성 검사 (knowsAptitude: false)
### ========================================

### AI 적성 검사 시작
POST {{host}}/ai/aptitude/test/start
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

> {%
  const data = response.body.data;
  if (data) {
    client.global.set("currentStep", data.step);
    if (data.aptitudeQuestionResponseDto) {
      client.global.set("currentQuestion", data.aptitudeQuestionResponseDto.question);
      console.log("\n🔮 AI 적성 검사 시작");
      console.log("질문:", data.aptitudeQuestionResponseDto.question);
    }
  }
%}

### AI 검사 답변 제출 (5회 반복)
POST {{host}}/ai/aptitude/test/answer
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "step": {{currentStep}},
  "questionText": "{{currentQuestion}}",
  "answer": "자연 속에서 산책하는 것을 좋아해요"
}

> {%
  const data = response.body.data;
  if (data) {
    if (data.isComplete) {
      console.log("\n✅ AI 적성 검사 완료!");
      console.log("최종 적성:", data.finalAptitude);
    } else {
      client.global.set("currentStep", data.step);
      if (data.aptitudeQuestionResponseDto) {
        client.global.set("currentQuestion", data.aptitudeQuestionResponseDto.question);
        console.log("\n다음 질문:", data.aptitudeQuestionResponseDto.question);
      }
    }
  }
%}

### ========================================
### 5. 온보딩 완료
### ========================================

### 온보딩 완료 처리
POST {{host}}/api/onboarding/complete
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

> {%
  const data = response.body.data;
  if (data) {
    console.log("\n🎉 온보딩 완료!");
    console.log("세션 ID:", data.sessionId);
    console.log("선택한 지역 특징:", data.regionType);
    console.log("완료 상태:", data.isCompleted);
    if (data.nextAction) {
      console.log("\n다음 이동:");
      console.log("- Endpoint:", data.nextAction.endpoint);
      console.log("- Description:", data.nextAction.description);
    }
  }
%}

### ========================================
### 6. 진행 상태 조회
### ========================================

### 현재 온보딩 진행 상태 조회
GET {{host}}/api/onboarding/progress
Authorization: Bearer {{accessToken}}

> {%
  const data = response.body.data;
  if (data) {
    console.log("\n=== 현재 온보딩 상태 ===");
    console.log("세션 ID:", data.sessionId);
    console.log("현재 단계:", data.currentStep);
    console.log("완료 여부:", data.isCompleted);
    console.log("선택한 지역 특징:", data.regionType);
    console.log("적성 인지 여부:", data.knowsAptitude);
  }
%}

### ========================================
### 시나리오별 전체 플로우 테스트
### ========================================

### 시나리오 A: 적성을 아는 사용자
# 1. 온보딩 시작
# 2. 지역 특징 선택 (URBAN)
# 3. 적성 인지 여부 (true - 알고있음)
# 4. 수동 적성 선택 (NATURE)
# 5. 온보딩 완료

### 시나리오 B: 적성을 모르는 사용자
# 1. 온보딩 시작
# 2. 지역 특징 선택 (BALANCED)
# 3. 적성 인지 여부 (false - 모름)
# 4. AI 적성 검사 (5단계)
# 5. 온보딩 완료

### ========================================
### 예외 케이스 테스트
### ========================================

### 잘못된 단계에서 지역 선택 시도
POST {{host}}/onboarding/region
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "regionType": "URBAN"
}

### 잘못된 단계에서 적성 확인 시도
POST {{host}}/onboarding/aptitude-check
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "knowsAptitude": true
}

### 이미 완료된 온보딩 재시작 시도
POST {{host}}/onboarding/start
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

### ========================================
### 온보딩 플로우 다이어그램
### ========================================
# 
#     [시작]
#       ↓
#   [회원 정보]
#       ↓
#   [지역 선택]
#       ↓
#  [적성 인지?]
#    ↙    ↘
#  [예]    [아니오]
#   ↓        ↓
# [수동]   [AI검사]
#   ↓        ↓
#   ↘      ↙
#    [완료]
#
### ========================================
